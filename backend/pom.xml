<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.16 - последний OSS-патч линии 3.5 (25.06.2026). Выбор обоснован в docs/DESIGN-DECISIONS.md. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ru.sibvibe</groupId>
    <artifactId>approval-backend</artifactId>
    <version>0.1.0</version>
    <name>approval-backend</name>
    <description>MAX hackathon - document approval backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Версии зафиксированы явно: критерий оценки "зависимости и их версии зафиксированы". -->
        <!-- 1.1.2 подтверждён по POM коннектора: он собран против Spring AI 1.1.2 / Spring Boot 3.5.10. -->
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-gigachat.version>1.1.2</spring-ai-gigachat.version>
        <minio.version>8.5.17</minio.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <springdoc.version>2.8.13</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ОБЯЗАТЕЛЕН: стартер GigaChat объявляет spring-ai-autoconfigure-* без версий. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Actuator: /actuator/health используется как healthcheck в compose.yaml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ИИ: GigaChat через Spring AI. -->
        <dependency>
            <groupId>chat.giga</groupId>
            <artifactId>spring-ai-starter-model-gigachat</artifactId>
            <version>${spring-ai-gigachat.version}</version>
        </dependency>

        <!-- Файлы документов. В Postgres только storage_key, бинарники не храним. -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- Извлечение текста из PDF перед отправкой в модель. Только чтение.
             DOCX читается без библиотек: это zip-архив с word/document.xml,
             хватает java.util.zip и StAX из JDK. Apache POI сознательно не берём -
             с транзитивными зависимостями это ~17 МБ загрузки в каждой холодной
             сборке при лимите 5 минут. Apache Tika не берём по той же причине. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Миграции схемы: воспроизводимость БД из переданного исходного кода. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI для внутренней документации и работы команды.
             ВАЖНО: собственный API как часть сдачи НЕ заявляем - см. docs/DESIGN-DECISIONS.md, решение C. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
