# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# .env добавлен в .gitignore и в репозиторий не попадает.
# Рабочие токены, пароли и ключи в репозитории запрещены правилами кейса -
# они передаются только на служебном первом слайде презентации.
# Реальных значений в этом файле нет и быть не должно.

# ---------- База данных ----------
DB_NAME=approval
DB_USER=approval
# Любая строка для локального запуска. Задать обязательно - compose не стартует без неё.
DB_PASSWORD=

# ---------- Хранилище файлов (MinIO) ----------
# Минимум 3 символа / 8 символов соответственно - требование MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents

# ---------- ИИ ----------
# Провайдер модели. Код зависит от порта, а не от конкретного провайдера.
# gigachat | openai-compatible | ollama | none
AI_PROVIDER=gigachat
# false полностью отключает обращения к LLM - остаются проверки по правилам.
AI_ENABLED=true

# Authorization key из личного кабинета GigaChat (Base64 client_id:client_secret).
# Единственный внешний сервис, невоспроизводимый внутри Docker.
# Если пусто - бэкенд стартует, сценарий проходится, ИИ-сверка деградирует
# до детерминированных проверок правил (см. README, раздел 12 «Поведение без GigaChat»).
GIGACHAT_CREDENTIALS=
# Идентификатор проекта. Секрет отдельно не нужен: он уже входит в Authorization key.
GIGACHAT_CLIENT_ID=
# GIGACHAT_API_PERS - физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP - юрлица.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Lite на наших тестовых документах даёт только 5/10 совпадений замечаний,
# поэтому по умолчанию используем проверенную модель Max.
GIGACHAT_MODEL=GigaChat-2-Max
AI_TIMEOUT_SECONDS=30

# ---------- MAX ----------
# Токен чат-бота выдаётся организаторами хакатона. Наш бот: @t354_hakaton_max_bot.
MAX_BOT_TOKEN=
# false отключает вызовы MAX Bot API целиком (приём обновлений и отправку уведомлений) -
# для временной остановки на стенде без удаления токена. По умолчанию true.
MAX_BOT_ENABLED=true
# Официальный адрес с 19.07.2026. Токен передаётся только заголовком Authorization.
MAX_BOT_API_URL=https://platform-api2.max.ru
# polling - локальная разработка, webhook - стенд сдачи. Одновременно оба не работают.
MAX_BOT_UPDATE_MODE=polling
# Только для webhook: публичный адрес backend (без пути) - бэкенд сам подпишется на
# <адрес>/api/v1/bot/webhook при старте. На локальной разработке не нужен.
MAX_BOT_WEBHOOK_URL=
# Секрет подписки webhook: MAX присылает его заголовком X-Max-Bot-Api-Secret, бэкенд сверяет.
# Обязателен при MAX_BOT_UPDATE_MODE=webhook - пустой секрет не "пропускает" проверку, а запрещает
# всё (fail closed) и подписка на webhook не выполняется. Формат по документации MAX: только
# A-Za-z0-9_- , 5-256 символов. Генерировать так: openssl rand -hex 32
# (НЕ openssl rand -base64 - в алфавите base64 есть +/=, они запрещены, подписка молча не пройдёт).
MAX_BOT_WEBHOOK_SECRET=
# Публичный HTTPS-адрес мини-приложения. Регистрируют организаторы по нашей форме,
# поэтому адрес постоянный: свой домен стенда, а не случайный адрес туннеля.
MAX_MINI_APP_URL=
# Ключ подписи ссылок скачивания. Можно не задавать: тогда случайный при каждом запуске.
DOWNLOAD_LINK_SECRET=

# ---------- Режимы ----------
# true - включает переключатель участника, чтобы один проверяющий мог пройти
# всю цепочку согласования самостоятельно. В проде false.
DEMO_MODE=false

# ---------- Напоминание о застрявшем шаге ----------
# Раз в сутки согласующему приходит напоминание о шаге, который висит в PENDING дольше
# REMINDERS_STUCK_AFTER_HOURS. Для демо снизьте порог и учащите REMINDERS_CRON без пересборки
# образа - например, REMINDERS_STUCK_AFTER_HOURS=0 и "0 * * * * *" (каждую минуту; в cron Spring первое поле — секунды,
# поэтому "* * * * * *" — это каждую секунду).
REMINDERS_ENABLED=true
REMINDERS_CRON=0 0 8 * * *
REMINDERS_STUCK_AFTER_HOURS=48
# Не чаще одного напоминания в сутки на шаг.
REMINDERS_COOLDOWN_HOURS=24

# ---------- Порты на хосте ----------
BACKEND_PORT=8080
FRONTEND_PORT=8081

# ---------- Реестр базовых образов ----------
# По умолчанию public.ecr.aws. Если образы не скачиваются, раскомментируйте строку ниже:
# образы те же (закреплены по digest), зеркало Docker Hub.
# BASE_REGISTRY=mirror.gcr.io/library
